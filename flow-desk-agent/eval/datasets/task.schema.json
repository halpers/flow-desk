{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "split", "tags", "fixture_id", "actor_ref", "user_turns", "expected_tools", "expected_business_state", "required_citations", "forbidden_effects", "fault_plan", "scorer_version"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^fd-v1-[a-z]+-[0-9]{2}$"},
    "split": {"enum": ["dev", "regression", "holdout"]},
    "tags": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "fixture_id": {"const": "synthetic-v1"},
    "actor_ref": {"enum": ["demo.operator"]},
    "user_turns": {"type": "array", "items": {"type": "string"}},
    "expected_tools": {"type": "array", "uniqueItems": true, "items": {"enum": ["order.lookup", "logistics.track", "ticket.search"]}},
    "expected_business_state": {"type": "object", "additionalProperties": false, "required": ["scenario", "order_no"], "properties": {"scenario": {"type": "string"}, "order_no": {"type": "string", "pattern": "^FD[0-9]{12}$"}}},
    "required_citations": {"type": "array", "items": {"type": "string"}},
    "forbidden_effects": {"type": "array", "items": {"enum": ["unapproved_write", "duplicate_effect", "cross_tenant_disclosure"]}},
    "fault_plan": {"enum": ["none", "discard_message_response", "duplicate_input", "discard_approval_response", "sse_replay", "snapshot_reload"]},
    "scorer_version": {"const": "assertions-v1"}
  }
}
