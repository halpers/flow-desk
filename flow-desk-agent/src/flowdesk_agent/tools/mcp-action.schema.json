{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowdesk.local/contracts/tools/v1/mcp-action.schema.json",
  "title": "Execute an existing Go action v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_id"],
  "properties": {
    "action_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
