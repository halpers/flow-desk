# Run scripts/bootstrap-local.ps1 to create a local ignored .env with random credentials.
POSTGRES_PASSWORD=replace-with-random-owner-password
BUSINESS_PASSWORD=replace-with-random-business-password
AGENT_PASSWORD=replace-with-random-agent-password
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_TOKEN=replace-with-random-service-token
DEMO_PASSWORD=replace-with-local-demo-password
PG_HOST_PORT=55432
API_HOST_PORT=18080
WEB_HOST_PORT=13000
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_JSON_MODE=json_object
# Independent embeddings endpoint; 0 keeps the provider's native dimensions.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=0
EMBEDDING_REVISION=1
RETRIEVAL_PROFILE=baseline
RERANK_PROVIDER=none
TOOL_TRANSPORT=http
APP_MODE=dev
OTEL_COLLECTOR_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_HOST_PORT=13001
PROMETHEUS_HOST_PORT=19090
JAEGER_HOST_PORT=16686
OTLP_HOST_PORT=14318
TLS_HOST_PORT=13443
COOKIE_SECURE=false
GOPROXY=https://goproxy.cn,direct
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Optional published images. Leave empty for local builds.
# Set all three to the same release/sha tag before compose pull + up --no-build.
FLOWDESK_API_IMAGE=
FLOWDESK_AGENT_IMAGE=
FLOWDESK_WEB_IMAGE=

# Optional private S3-compatible PDF archival. Defaults keep originals in PostgreSQL.
FILE_STORE_PROVIDER=postgres
FILE_STORE_CLEANUP_ENABLED=false
FILE_STORE_INVENTORY_ENABLED=false
FILE_STORE_TENANT_INVENTORY_ENABLED=false
FILE_STORE_ADOPTION_ENABLED=false
FILE_STORE_ENDPOINT=
FILE_STORE_REGION=us-east-1
FILE_STORE_BUCKET=
FILE_STORE_ACCESS_KEY=
FILE_STORE_SECRET_KEY=
FILE_STORE_ALLOW_HTTP=false
