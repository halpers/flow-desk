syntax = "v1"

type KnowledgeBaseData {
    TeamId string `json:"team_id"`
    Id string `json:"id"`
    Name string `json:"name"`
    ReadRoles []string `json:"read_roles"`
    AclRevision int64 `json:"acl_revision"`
}
type KnowledgeBaseWriteReq {
    Name string `json:"name"`
    ReadRoles []string `json:"read_roles"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type KnowledgeBaseReq {
    KnowledgeBaseId string `path:"knowledge_base_id"`
}

type RetentionPolicyData {
    KnowledgeBaseId string `json:"knowledge_base_id"`
    KeepLatest int64 `json:"keep_latest"`
    MinimumAgeDays int64 `json:"minimum_age_days"`
    Revision int64 `json:"revision"`
}

type RetentionPolicyResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data RetentionPolicyData `json:"data"`
}

type UpdateRetentionPolicyReq {
    KnowledgeBaseId string `path:"knowledge_base_id"`
    KeepLatest int64 `json:"keep_latest"`
    MinimumAgeDays int64 `json:"minimum_age_days"`
    ExpectedRevision int64 `json:"expected_revision"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type KnowledgeAclReq {
    KnowledgeBaseId string `path:"knowledge_base_id"`
    ReadRoles []string `json:"read_roles"`
    ExpectedRevision int64 `json:"expected_revision"`
}
type KnowledgeBaseResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data KnowledgeBaseData `json:"data"`
}
type KnowledgeBasePage {
    Items []KnowledgeBaseData `json:"items"`
}
type KnowledgeBasesResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data KnowledgeBasePage `json:"data"`
}
type DocumentData {
    Id string `json:"id"`
    KnowledgeBaseId string `json:"knowledge_base_id"`
    Title string `json:"title"`
    ActiveVersionId string `json:"active_version_id"`
    Version int64 `json:"version"`
    Status string `json:"status"`
}
type UploadDocumentReq {
    PdfLayout string `json:"pdf_layout,optional"`
    OcrMode string `json:"ocr_mode,optional"`
    KnowledgeBaseId string `path:"knowledge_base_id"`
    Title string `json:"title"`
    Filename string `json:"filename"`
    Content string `json:"content,optional"`
    ContentBase64 string `json:"content_base64,optional"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type UploadVersionReq {
    PdfLayout string `json:"pdf_layout,optional"`
    OcrMode string `json:"ocr_mode,optional"`
    DocumentId string `path:"document_id"`
    Filename string `json:"filename"`
    Content string `json:"content,optional"`
    ContentBase64 string `json:"content_base64,optional"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type DocumentReq {
    DocumentId string `path:"document_id"`
}
type VersionData {
    CleanupState string `json:"cleanup_state"`
    PdfLayout string `json:"pdf_layout"`
    SourceStorage string `json:"source_storage"`
    OcrMode string `json:"ocr_mode"`
    OcrPageCount int64 `json:"ocr_page_count"`
    SourceFormat string `json:"source_format"`
    SourceSize int64 `json:"source_size"`
    PageCount int64 `json:"page_count"`
    TextPageCount int64 `json:"text_page_count"`
    Id string `json:"id"`
    DocumentId string `json:"document_id"`
    Filename string `json:"filename"`
    ContentHash string `json:"content_hash"`
    IndexStatus string `json:"index_status"`
    ChunkCount int64 `json:"chunk_count"`
    ErrorCode string `json:"error_code"`
}
type DocumentPage {
    Items []DocumentData `json:"items"`
}
type DocumentsResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data DocumentPage `json:"data"`
}
type DocumentResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data DocumentData `json:"data"`
}
type VersionPage {
    Items []VersionData `json:"items"`
}
type VersionHistoryReq {
    DocumentId string `path:"document_id"`
    Cursor string `form:"cursor,optional"`
    Limit int64 `form:"limit,optional"`
}
type VersionHistoryItem {
    Id string `json:"id"`
    DocumentId string `json:"document_id"`
    Filename string `json:"filename"`
    CreatedAt string `json:"created_at"`
    CleanupState string `json:"cleanup_state"`
    ContentHash string `json:"content_hash"`
    IndexStatus string `json:"index_status"`
    ChunkCount int64 `json:"chunk_count"`
    ErrorCode string `json:"error_code"`
    ParserVersion string `json:"parser_version"`
    OcrMode string `json:"ocr_mode"`
    PdfLayout string `json:"pdf_layout"`
    SourceFormat string `json:"source_format"`
    SourceSize int64 `json:"source_size"`
    MetadataArchived bool `json:"metadata_archived"`
    ArchivedAt string `json:"archived_at"`
    CanArchive bool `json:"can_archive"`
    ArchiveBlockReason string `json:"archive_block_reason"`
}
type VersionHistoryPage {
    DocumentVersion int64 `json:"document_version"`
    Items []VersionHistoryItem `json:"items"`
    HasMore bool `json:"has_more"`
    NextCursor string `json:"next_cursor"`
}
type VersionHistoryResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data VersionHistoryPage `json:"data"`
}
type ArchiveMetadataReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    ExpectedDocumentVersion int64 `json:"expected_document_version"`
    Confirm bool `json:"confirm"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type MetadataArchiveData {
    VersionId string `json:"version_id"`
    DocumentId string `json:"document_id"`
    ArchivedAt string `json:"archived_at"`
}
type MetadataArchiveResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data MetadataArchiveData `json:"data"`
}
type VersionsResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data VersionPage `json:"data"`
}
type VersionResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data VersionData `json:"data"`
}
type ActivateDocumentReq {
    ConfirmLayout bool `json:"confirm_layout,optional"`
    ConfirmOcr bool `json:"confirm_ocr,optional"`
    DocumentId string `path:"document_id"`
    VersionId string `json:"version_id"`
    ExpectedVersion int64 `json:"expected_version"`
}
type WithdrawDocumentReq {
    DocumentId string `path:"document_id"`
    ExpectedVersion int64 `json:"expected_version"`
}
type IndexSourceReq {
    VersionId string `path:"version_id"`
    JobId string `form:"job_id"`
}
type IndexSourceData {
    PdfLayout string `json:"pdf_layout"`
    OcrMode string `json:"ocr_mode"`
    SourceFormat string `json:"source_format"`
    SourceBase64 string `json:"source_base64"`
    TenantId string `json:"tenant_id"`
    KnowledgeBaseId string `json:"knowledge_base_id"`
    DocumentId string `json:"document_id"`
    VersionId string `json:"version_id"`
    Content string `json:"content"`
    ContentHash string `json:"content_hash"`
}
type IndexSourceResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data IndexSourceData `json:"data"`
}
type IndexCompleteReq {
    PageTexts []KnowledgePageText `json:"page_texts,optional"`
    ParserVersion string `json:"parser_version,optional"`
    ErrorCode string `json:"error_code,optional"`
    VersionId string `path:"version_id"`
    JobId string `json:"job_id"`
    ContentHash string `json:"content_hash"`
    ChunkCount int64 `json:"chunk_count"`
    Status string `json:"status"`
}
type ScopeVersion {
    VersionId string `json:"version_id"`
    DocumentId string `json:"document_id"`
    KnowledgeBaseId string `json:"knowledge_base_id"`
    Title string `json:"title"`
    AclRevision int64 `json:"acl_revision"`
}
type KnowledgeScope {
    TenantId string `json:"tenant_id"`
    Versions []ScopeVersion `json:"versions"`
}
type KnowledgeScopeResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data KnowledgeScope `json:"data"`
}
type EvidenceCandidate {
    PageNumber int64 `json:"page_number,optional"`
    VersionId string `json:"version_id"`
    ChunkId string `json:"chunk_id"`
    Excerpt string `json:"excerpt"`
    ContentHash string `json:"content_hash"`
}
type EvidenceData {
    ExtractionMethod string `json:"extraction_method,optional"`
    PageNumber int64 `json:"page_number"`
    Id string `json:"id"`
    VersionId string `json:"version_id"`
    ChunkId string `json:"chunk_id"`
    Title string `json:"title"`
    Excerpt string `json:"excerpt"`
}
type EvidenceReq {
    RunId string `path:"run_id"`
    Candidates []EvidenceCandidate `json:"candidates"`
}
type EvidencePage {
    Items []EvidenceData `json:"items"`
}
type EvidenceResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data EvidencePage `json:"data"`
}
type CitationReq {
    EvidenceId string `path:"evidence_id"`
}
type CitationResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data EvidenceData `json:"data"`
}

type KnowledgePageText {
    ExtractionMethod string `json:"extraction_method,optional"`
    PageNumber int64 `json:"page_number"`
    Text string `json:"text"`
}
type VersionPagesReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
}
type VersionPagesData {
    VersionId string `json:"version_id"`
    ParserVersion string `json:"parser_version"`
    Pages []KnowledgePageText `json:"pages"`
}
type VersionPagesResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data VersionPagesData `json:"data"`
}
type OriginalSourceData {
    Filename string `json:"filename"`
    ContentHash string `json:"content_hash"`
    ContentBase64 string `json:"content_base64"`
    SourceFormat string `json:"source_format"`
}
type OriginalSourceResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data OriginalSourceData `json:"data"`
}
type ArchiveSourceReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    IdempotencyKey string `header:"Idempotency-Key"`
}

type RetentionItem {

    VersionId string `json:"version_id"`
    Filename string `json:"filename"`
    CreatedAt string `json:"created_at"`
    CleanupState string `json:"cleanup_state"`
    SourceSize int64 `json:"source_size"`
    Eligible bool `json:"eligible"`
    Reasons []string `json:"reasons"`
}
type RetentionPlan {
    PolicyRevision int64 `json:"policy_revision"`
    DocumentId string `json:"document_id"`
    DocumentVersion int64 `json:"document_version"`
    KeepLatest int64 `json:"keep_latest"`
    MinimumAgeDays int64 `json:"minimum_age_days"`
    Items []RetentionItem `json:"items"`
}
type RetentionResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data RetentionPlan `json:"data"`
}
type CleanupVersionReq {
    ExpectedPolicyRevision int64 `json:"expected_policy_revision,optional,omitempty"`
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    ExpectedDocumentVersion int64 `json:"expected_document_version"`
    Confirm bool `json:"confirm"`
    IdempotencyKey string `header:"Idempotency-Key"`
}

type SourceCopyHistoryReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    Cursor string `form:"cursor,optional"`
    Limit int64 `form:"limit,optional"`
}
type SourceCopyHistoryItem {
    Id string `json:"id"`
    SourceEpoch int64 `json:"source_epoch"`
    SourceSize int64 `json:"source_size"`
    Status string `json:"status"`
    CreatedAt string `json:"created_at"`
    RetiredAt string `json:"retired_at"`
    MetadataArchived bool `json:"metadata_archived"`
    ArchivedAt string `json:"archived_at"`
    CanArchive bool `json:"can_archive"`
    ArchiveBlockReason string `json:"archive_block_reason"`
}
type SourceCopyHistoryPage {
    VersionId string `json:"version_id"`
    SourceEpoch int64 `json:"source_epoch"`
    Items []SourceCopyHistoryItem `json:"items"`
    HasMore bool `json:"has_more"`
    NextCursor string `json:"next_cursor"`
}
type SourceCopyHistoryResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data SourceCopyHistoryPage `json:"data"`
}
type ArchiveSourceMetadataReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    ObjectId string `path:"object_id"`
    ExpectedSourceEpoch int64 `json:"expected_source_epoch"`
    Confirm bool `json:"confirm"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type SourceMetadataArchiveData {
    ObjectId string `json:"object_id"`
    VersionId string `json:"version_id"`
    ArchivedAt string `json:"archived_at"`
}
type SourceMetadataArchiveResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data SourceMetadataArchiveData `json:"data"`
}

type ArchiveCopyItem {
    Id string `json:"id"`
    SourceEpoch int64 `json:"source_epoch"`
    SourceSize int64 `json:"source_size"`
    Status string `json:"status"`
    Eligible bool `json:"eligible"`
    Reasons []string `json:"reasons"`
}
type ArchiveCopiesData {
    VersionId string `json:"version_id"`
    SourceEpoch int64 `json:"source_epoch"`
    Enabled bool `json:"enabled"`
    Items []ArchiveCopyItem `json:"items"`
}
type TenantSourceInventoryReq {
    Cursor string `form:"cursor,optional"`
    Limit int64 `form:"limit,optional"`
}
type SourceInvestigationListReq {
    Status string `form:"status,optional"`
    Cursor string `form:"cursor,optional"`
    Limit int64 `form:"limit,optional"`
}
type SourceInvestigationListItem {
    ObjectRef string `json:"object_ref"`
    Revision int64 `json:"revision"`
    Status string `json:"status"`
    CreatedAt string `json:"created_at"`
    UpdatedBy string `json:"updated_by"`
    UpdatedAt string `json:"updated_at"`
}
type SourceInvestigationListPage {
    Items []SourceInvestigationListItem `json:"items"`
    HasMore bool `json:"has_more"`
    NextCursor string `json:"next_cursor"`
    AllowedStatuses []string `json:"allowed_statuses"`
}
type SourceInvestigationListResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data SourceInvestigationListPage `json:"data"`
}
type RestoreInvestigationRevisionReq {
    ObjectRef string `path:"object_ref"`
    Revision int64 `path:"revision"`
    ExpectedRevision int64 `json:"expected_revision"`
    Confirm bool `json:"confirm"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type InvestigationRestoreData {
    RestoredFromRevision int64 `json:"restored_from_revision"`
    Investigation SourceInvestigationData `json:"investigation"`
}
type InvestigationRestoreResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data InvestigationRestoreData `json:"data"`
}

type InvestigationHistoryReq {
    ObjectRef string `path:"object_ref"`
    Cursor string `form:"cursor,optional"`
    Limit int64 `form:"limit,optional"`
}
type InvestigationRevisionItem {
    Revision int64 `json:"revision"`
    Status string `json:"status"`
    Note string `json:"note"`
    ChangedBy string `json:"changed_by"`
    ChangedAt string `json:"changed_at"`
    IsBaseline bool `json:"is_baseline"`
}
type InvestigationHistoryPage {
    ObjectRef string `json:"object_ref"`
    CurrentRevision int64 `json:"current_revision"`
    SnapshotRevision int64 `json:"snapshot_revision"`
    FirstRecordedRevision int64 `json:"first_recorded_revision"`
    Items []InvestigationRevisionItem `json:"items"`
    HasMore bool `json:"has_more"`
    NextCursor string `json:"next_cursor"`
}
type InvestigationHistoryResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data InvestigationHistoryPage `json:"data"`
}
type SourceInvestigationReq {
    ObjectRef string `path:"object_ref"`
}
type SaveSourceInvestigationReq {
    ObjectRef string `path:"object_ref"`
    SelectionToken string `json:"selection_token,optional"`
    ExpectedRevision int64 `json:"expected_revision"`
    Status string `json:"status"`
    Note string `json:"note"`
    Confirm bool `json:"confirm"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type SourceInvestigationData {
    ObjectRef string `json:"object_ref"`
    Revision int64 `json:"revision"`
    Status string `json:"status"`
    Note string `json:"note"`
    UpdatedBy string `json:"updated_by"`
    UpdatedAt string `json:"updated_at"`
    AllowedStatuses []string `json:"allowed_statuses"`
}
type SourceInvestigationResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data SourceInvestigationData `json:"data"`
}

type TenantSourceInventoryItem {
    InvestigationToken string `json:"investigation_token"`
    ObjectRef string `json:"object_ref"`
    KeyKind string `json:"key_kind"`
    SourceEpoch int64 `json:"source_epoch"`
    Size int64 `json:"size"`
    ModifiedAt string `json:"modified_at"`
    Association string `json:"association"`
    Reconciliation string `json:"reconciliation"`
    DocumentId string `json:"document_id"`
    VersionId string `json:"version_id"`
    RegisteredId string `json:"registered_id"`
    RegisteredStatus string `json:"registered_status"`
}
type TenantSourceInventoryPage {
    ObservedAt string `json:"observed_at"`
    ContentVerified bool `json:"content_verified"`
    ScannedCount int64 `json:"scanned_count"`
    Items []TenantSourceInventoryItem `json:"items"`
    HasMore bool `json:"has_more"`
    NextCursor string `json:"next_cursor"`
}
type TenantSourceInventoryResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data TenantSourceInventoryPage `json:"data"`
}

type SourceInventoryReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    Cursor string `form:"cursor,optional"`
    Limit int64 `form:"limit,optional"`
}
type SourceInventoryItem {
    AdoptionEligible bool `json:"adoption_eligible"`
    AdoptionReason string `json:"adoption_reason"`
    AdoptionToken string `json:"adoption_token"`
    ObjectRef string `json:"object_ref"`
    RegisteredId string `json:"registered_id"`
    RegisteredStatus string `json:"registered_status"`
    KeyKind string `json:"key_kind"`
    SourceEpoch int64 `json:"source_epoch"`
    Size int64 `json:"size"`
    ModifiedAt string `json:"modified_at"`
    Reconciliation string `json:"reconciliation"`
}
type SourceInventoryPage {
    AdoptionEnabled bool `json:"adoption_enabled"`
    VersionId string `json:"version_id"`
    SourceSize int64 `json:"source_size"`
    SourceEpoch int64 `json:"source_epoch"`
    ObservedAt string `json:"observed_at"`
    ContentVerified bool `json:"content_verified"`
    Items []SourceInventoryItem `json:"items"`
    HasMore bool `json:"has_more"`
    NextCursor string `json:"next_cursor"`
}
type SourceInventoryResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data SourceInventoryPage `json:"data"`
}

type SourceAdoptionReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    ObjectRef string `json:"object_ref"`
    AdoptionToken string `json:"adoption_token"`
    ExpectedSourceEpoch int64 `json:"expected_source_epoch"`
    Confirm bool `json:"confirm"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type SourceAdoptionData {
    ObjectId string `json:"object_id"`
    ObjectRef string `json:"object_ref"`
    VersionId string `json:"version_id"`
    SourceEpoch int64 `json:"source_epoch"`
    VerifiedAt string `json:"verified_at"`
}
type SourceAdoptionResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data SourceAdoptionData `json:"data"`
}
type ArchiveCopiesResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data ArchiveCopiesData `json:"data"`
}
type CleanupArchiveCopyReq {
    DocumentId string `path:"document_id"`
    VersionId string `path:"version_id"`
    ObjectId string `path:"object_id"`
    ExpectedSourceEpoch int64 `json:"expected_source_epoch"`
    Confirm bool `json:"confirm"`
    IdempotencyKey string `header:"Idempotency-Key"`
}
type ArchiveCopyResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data ArchiveCopyItem `json:"data"`
}

@server(prefix: /api/v1 middleware: SessionAuth)
service flowdesk-api {
    @doc "ListSourceInvestigations | permission=knowledge:manage | auth=required | role=admin"
    @handler ListSourceInvestigations
    get /source-investigations (SourceInvestigationListReq) returns (SourceInvestigationListResp)
    @doc "RestoreInvestigationRevision | permission=knowledge:manage | auth=required | role=admin"
    @handler RestoreInvestigationRevision
    post /source-investigations/:object_ref/history/:revision/restore (RestoreInvestigationRevisionReq) returns (InvestigationRestoreResp)
    @doc "ListInvestigationHistory | permission=knowledge:manage | auth=required | role=admin"
    @handler ListInvestigationHistory
    get /source-investigations/:object_ref/history (InvestigationHistoryReq) returns (InvestigationHistoryResp)
    @doc "GetSourceInvestigation | permission=knowledge:manage | auth=required | role=admin"
    @handler GetSourceInvestigation
    get /source-investigations/:object_ref (SourceInvestigationReq) returns (SourceInvestigationResp)
    @doc "SaveSourceInvestigation | permission=knowledge:manage | auth=required | role=admin"
    @handler SaveSourceInvestigation
    put /source-investigations/:object_ref (SaveSourceInvestigationReq) returns (SourceInvestigationResp)
    @doc "GetTenantSourceInventory | permission=knowledge:manage | auth=required | role=admin"
    @handler GetTenantSourceInventory
    get /source-inventory (TenantSourceInventoryReq) returns (TenantSourceInventoryResp)
    @doc "GetSourceInventory | permission=knowledge:manage | auth=required"
    @handler GetSourceInventory
    get /documents/:document_id/versions/:version_id/source-inventory (SourceInventoryReq) returns (SourceInventoryResp)
    @doc "AdoptSourceObject | permission=knowledge:manage | auth=required"
    @handler AdoptSourceObject
    post /documents/:document_id/versions/:version_id/source-adoptions (SourceAdoptionReq) returns (SourceAdoptionResp)
    @doc "ListVersionHistory | permission=knowledge:manage | auth=required"
    @handler ListVersionHistory
    get /documents/:document_id/history (VersionHistoryReq) returns (VersionHistoryResp)
    @doc "ArchiveVersionMetadata | permission=knowledge:manage | auth=required"
    @handler ArchiveVersionMetadata
    post /documents/:document_id/versions/:version_id/archive-metadata (ArchiveMetadataReq) returns (MetadataArchiveResp)
    @doc "GetRetentionPolicy | permission=knowledge:manage | auth=required"
    @handler GetRetentionPolicy
    get /knowledge-bases/:knowledge_base_id/retention-policy (KnowledgeBaseReq) returns (RetentionPolicyResp)
    @doc "UpdateRetentionPolicy | permission=knowledge:manage | auth=required"
    @handler UpdateRetentionPolicy
    put /knowledge-bases/:knowledge_base_id/retention-policy (UpdateRetentionPolicyReq) returns (RetentionPolicyResp)
    @doc "ListSourceCopyHistory | permission=knowledge:manage | auth=required"
    @handler ListSourceCopyHistory
    get /documents/:document_id/versions/:version_id/archive-copies/history (SourceCopyHistoryReq) returns (SourceCopyHistoryResp)
    @doc "ArchiveSourceMetadata | permission=knowledge:manage | auth=required"
    @handler ArchiveSourceMetadata
    post /documents/:document_id/versions/:version_id/archive-copies/:object_id/archive-metadata (ArchiveSourceMetadataReq) returns (SourceMetadataArchiveResp)
    @doc "ListArchiveCopies | permission=knowledge:manage | auth=required"
    @handler ListArchiveCopies
    get /documents/:document_id/versions/:version_id/archive-copies (VersionPagesReq) returns (ArchiveCopiesResp)
    @doc "CleanupArchiveCopy | permission=knowledge:manage | auth=required"
    @handler CleanupArchiveCopy
    post /documents/:document_id/versions/:version_id/archive-copies/:object_id/cleanup (CleanupArchiveCopyReq) returns (ArchiveCopyResp)
    @doc "GetRetentionPlan | permission=knowledge:manage | auth=required"
    @handler GetRetentionPlan
    get /documents/:document_id/retention (DocumentReq) returns (RetentionResp)
    @doc "CleanupDocumentVersion | permission=knowledge:manage | auth=required"
    @handler CleanupDocumentVersion
    post /documents/:document_id/versions/:version_id/cleanup (CleanupVersionReq) returns (VersionResp)
    @doc "ListKnowledgeBases | permission=conversation:use | auth=required"
    @handler ListKnowledgeBases
    get /knowledge-bases returns (KnowledgeBasesResp)
    @doc "CreateKnowledgeBase | permission=knowledge:manage | auth=required"
    @handler CreateKnowledgeBase
    post /knowledge-bases (KnowledgeBaseWriteReq) returns (KnowledgeBaseResp)
    @doc "UpdateKnowledgeAcl | permission=knowledge:manage | auth=required"
    @handler UpdateKnowledgeAcl
    patch /knowledge-bases/:knowledge_base_id (KnowledgeAclReq) returns (KnowledgeBaseResp)
    @doc "ListDocuments | permission=conversation:use | auth=required"
    @handler ListDocuments
    get /knowledge-bases/:knowledge_base_id/documents (KnowledgeBaseReq) returns (DocumentsResp)
    @doc "UploadDocument | permission=knowledge:manage | auth=required"
    @handler UploadDocument
    post /knowledge-bases/:knowledge_base_id/documents (UploadDocumentReq) returns (VersionResp)
    @doc "ListDocumentVersions | permission=knowledge:manage | auth=required"
    @handler ListDocumentVersions
    get /documents/:document_id/versions (DocumentReq) returns (VersionsResp)
    @doc "PreviewVersionPages | permission=knowledge:manage | auth=required"
    @handler PreviewVersionPages
    get /documents/:document_id/versions/:version_id/pages (VersionPagesReq) returns (VersionPagesResp)
    @doc "DownloadOriginalSource | permission=knowledge:manage | auth=required"
    @handler DownloadOriginalSource
    get /documents/:document_id/versions/:version_id/source (VersionPagesReq) returns (OriginalSourceResp)
    @doc "RequestSourceArchive | permission=knowledge:manage | auth=required"
    @handler RequestSourceArchive
    post /documents/:document_id/versions/:version_id/archive (ArchiveSourceReq) returns (VersionResp)
    @doc "RestoreOriginalSource | permission=knowledge:manage | auth=required"
    @handler RestoreOriginalSource
    post /documents/:document_id/versions/:version_id/restore-source (ArchiveSourceReq) returns (VersionResp)
    @doc "UploadDocumentVersion | permission=knowledge:manage | auth=required"
    @handler UploadDocumentVersion
    post /documents/:document_id/versions (UploadVersionReq) returns (VersionResp)
    @doc "ActivateDocument | permission=knowledge:manage | auth=required"
    @handler ActivateDocument
    post /documents/:document_id/activate (ActivateDocumentReq) returns (DocumentResp)
    @doc "WithdrawDocument | permission=knowledge:manage | auth=required"
    @handler WithdrawDocument
    post /documents/:document_id/withdraw (WithdrawDocumentReq) returns (DocumentResp)
    @doc "GetCitation | permission=conversation:use | auth=required"
    @handler GetCitation
    get /citations/:evidence_id (CitationReq) returns (CitationResp)
}
@server(prefix: /internal/v1 middleware: ServiceAuth)
service flowdesk-api {
    @doc "GetIndexSource | permission=- | auth=service"
    @handler GetIndexSource
    get /knowledge/versions/:version_id/source (IndexSourceReq) returns (IndexSourceResp)
    @doc "CompleteIndex | permission=- | auth=service"
    @handler CompleteIndex
    post /knowledge/versions/:version_id/complete (IndexCompleteReq) returns (VersionResp)
    @doc "GetKnowledgeScope | permission=- | auth=run_capability"
    @handler GetKnowledgeScope
    get /runs/:run_id/knowledge-scope (RunReq) returns (KnowledgeScopeResp)
    @doc "ValidateEvidence | permission=- | auth=run_capability"
    @handler ValidateEvidence
    post /runs/:run_id/knowledge/validate (EvidenceReq) returns (EvidenceResp)
}
