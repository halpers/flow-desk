syntax = "v1"

type RunsPageReq {
    Scope string `form:"scope,default=own"`
    Status string `form:"status,optional"`
    RunId string `form:"run_id,optional"`
    Cursor string `form:"cursor,optional"`
    Limit int64 `form:"limit,default=20,range=[1:50]"`
}
type RunOperationData {
    Id string `json:"id"`
    ConversationId string `json:"conversation_id"`
    ActorUserId string `json:"actor_user_id"`
    Status string `json:"status"`
    Version int64 `json:"version"`
    ErrorCode string `json:"error_code"`
    ToolCallCount int64 `json:"tool_call_count"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    RetryOfRunId string `json:"retry_of_run_id"`
    RetriedByRunId string `json:"retried_by_run_id"`
    RetryDepth int64 `json:"retry_depth"`
    CanRetry bool `json:"can_retry"`
    RetryBlockReason string `json:"retry_block_reason"`
}
type RunOperationPage {
    Items []RunOperationData `json:"items"`
    NextCursor string `json:"next_cursor"`
    HasMore bool `json:"has_more"`
}
type RunOperationsResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data RunOperationPage `json:"data"`
}
type RetryRunReq {
    RunId string `path:"run_id"`
    IdempotencyKey string `header:"Idempotency-Key"`
    ExpectedVersion int64 `json:"expected_version"`
}
type NodeObservation {
    Node string `json:"node"`
    Status string `json:"status"`
    DurationMs int64 `json:"duration_ms"`
    Generation int64 `json:"generation"`
    CompletedAt string `json:"completed_at"`
}
type ModelObservation {
    Status string `json:"status"`
    ErrorCode string `json:"error_code"`
    DurationMs int64 `json:"duration_ms"`
    DurationKnown bool `json:"duration_known"`
    InputTokens int64 `json:"input_tokens"`
    OutputTokens int64 `json:"output_tokens"`
    TokensKnown bool `json:"tokens_known"`
}
type ToolObservation {
    Tool string `json:"tool"`
    CompletedCount int64 `json:"completed_count"`
}
type RunUsage {
    RetrievalAttempts int64 `json:"retrieval_attempts"`
    ModelAttempts int64 `json:"model_attempts"`
    InputTokens int64 `json:"input_tokens"`
    OutputTokens int64 `json:"output_tokens"`
    ModelTokensKnown bool `json:"model_tokens_known"`
    EmbeddingAttempts int64 `json:"embedding_attempts"`
    EmbeddingInputTokens int64 `json:"embedding_input_tokens"`
    EmbeddingTokensKnown bool `json:"embedding_tokens_known"`
    CostStatus string `json:"cost_status"`
}
type AgentTraceData {
    Available bool `json:"available"`
    Truncated bool `json:"truncated"`
    Nodes []NodeObservation `json:"nodes"`
    Models []ModelObservation `json:"models"`
    Tools []ToolObservation `json:"tools"`
    Usage RunUsage `json:"usage"`
}
type RunTraceData {
    Run RunOperationData `json:"run"`
    Observation AgentTraceData `json:"observation"`
}
type RunTraceResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data RunTraceData `json:"data"`
}

type AgentLifecycleData {
    Available bool `json:"available"`
    ObservedAt string `json:"observed_at"`
    ObservationOnly bool `json:"observation_only"`
    CommandCount int64 `json:"command_count"`
    QueuedCommandCount int64 `json:"queued_command_count"`
    RunningCommandCount int64 `json:"running_command_count"`
    WaitingCommandCount int64 `json:"waiting_command_count"`
    LiveCommandLeaseCount int64 `json:"live_command_lease_count"`
    CallbackCount int64 `json:"callback_count"`
    UnacknowledgedCallbackCount int64 `json:"unacknowledged_callback_count"`
    LiveCallbackLeaseCount int64 `json:"live_callback_lease_count"`
    ModelCallCount int64 `json:"model_call_count"`
    ReservedModelCallCount int64 `json:"reserved_model_call_count"`
    CheckpointCount int64 `json:"checkpoint_count"`
    CheckpointBlobCount int64 `json:"checkpoint_blob_count"`
    CheckpointWriteCount int64 `json:"checkpoint_write_count"`
    ToolResultCount int64 `json:"tool_result_count"`
    ExecutionSpanCount int64 `json:"execution_span_count"`
    RetrievalAttemptCount int64 `json:"retrieval_attempt_count"`
    EmbeddingCallCount int64 `json:"embedding_call_count"`
    ReservedEmbeddingCallCount int64 `json:"reserved_embedding_call_count"`
    ProtectionReasons []string `json:"protection_reasons"`
}
type BusinessLifecycleData {
    MessageCount int64 `json:"message_count"`
    EventCount int64 `json:"event_count"`
    ActionCount int64 `json:"action_count"`
    ApprovalCount int64 `json:"approval_count"`
    PendingApprovalCount int64 `json:"pending_approval_count"`
    PendingInputCount int64 `json:"pending_input_count"`
    ReceiptCount int64 `json:"receipt_count"`
    EvidenceCount int64 `json:"evidence_count"`
    DispatchCount int64 `json:"dispatch_count"`
    UnsettledDispatchCount int64 `json:"unsettled_dispatch_count"`
    RetryLinkCount int64 `json:"retry_link_count"`
    ActiveConversationRunCount int64 `json:"active_conversation_run_count"`
    ResourceReferenceCount int64 `json:"resource_reference_count"`
    LeaseActive bool `json:"lease_active"`
}
type RunLifecycleData {
    Run RunOperationData `json:"run"`
    ObservedAt string `json:"observed_at"`
    MinimumAgeDays int64 `json:"minimum_age_days"`
    ObservationOnly bool `json:"observation_only"`
    ArchiveCandidate bool `json:"archive_candidate"`
    ProtectionReasons []string `json:"protection_reasons"`
    Business BusinessLifecycleData `json:"business"`
    Agent AgentLifecycleData `json:"agent"`
}
type RunLifecycleResp {
    Code string `json:"code"`
    RequestId string `json:"request_id"`
    Data RunLifecycleData `json:"data"`
}

@server(prefix: /api/v1 middleware: SessionAuth)
service flowdesk-api {
    @doc "List authorized run metadata | permission=conversation:use/run:observe | auth=required"
    @handler ListRuns
    get /runs (RunsPageReq) returns (RunOperationsResp)
    @doc "Read authorized sanitized trace | permission=conversation:use/run:observe | auth=required"
    @handler GetRunTrace
    get /runs/:run_id/trace (RunReq) returns (RunTraceResp)
    @doc "Preview authorized run lifecycle metadata only | permission=conversation:use/run:observe | auth=required"
    @handler GetRunLifecycle
    get /runs/:run_id/lifecycle (RunReq) returns (RunLifecycleResp)
    @doc "Retry own failed run without prepared actions | permission=conversation:use | auth=required"
    @handler RetryRun
    post /runs/:run_id/retry (RetryRunReq) returns (RunResp)
}
