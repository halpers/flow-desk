syntax = "v1"

type ChangeOwnPasswordReq {
 CurrentPassword string `json:"current_password"`
 NewPassword string `json:"new_password"`
 Confirm bool `json:"confirm"`
}

@server(prefix: /api/v1/auth middleware: SessionAuth)
service flowdesk-api {
 @doc "Change own password and revoke all sessions | permission=- | auth=required"
 @handler ChangeOwnPassword
 post /password (ChangeOwnPasswordReq) returns (EmptyResp)
}
