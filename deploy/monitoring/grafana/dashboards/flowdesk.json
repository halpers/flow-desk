{
  "uid": "flowdesk-operations", "title": "FlowDesk operations", "schemaVersion": 39,
  "version": 1, "refresh": "5s", "time": {"from": "now-30m", "to": "now"},
  "tags": ["flowdesk"], "panels": [
    {"id": 1, "title": "Scrape availability", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "up{job=~\"flowdesk-.*\"}", "legendFormat": "{{job}}"}]},
    {"id": 2, "title": "Active and queued Agent commands", "type": "timeseries", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_commands{status=~\"queued|running|waiting\"}", "legendFormat": "{{status}}"}]},
    {"id": 3, "title": "Retained model tokens", "type": "stat", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_model_tokens", "legendFormat": "{{direction}}"}]},
    {"id": 4, "title": "Callback backlog", "type": "timeseries", "gridPos": {"x": 0, "y": 5, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_callbacks{status=~\"pending|delivering|permanent_failure\"}", "legendFormat": "{{status}}"}]},
    {"id": 5, "title": "Retained model / embedding failures", "type": "timeseries", "gridPos": {"x": 8, "y": 5, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_model_calls{status=\"failed\"}", "legendFormat": "model"}, {"refId": "B", "expr": "flowdesk_agent_embedding_calls{status=\"failed\"}", "legendFormat": "embedding"}]},
    {"id": 6, "title": "Index job state", "type": "timeseries", "gridPos": {"x": 16, "y": 5, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_index_jobs{status=~\"pending|working|failed\"}", "legendFormat": "{{status}}"}]},
    {"id": 7, "title": "Reranking P95 (last five minutes, ms)", "type": "stat", "gridPos": {"x": 0, "y": 12, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_rerank_p95_milliseconds"}]},
    {"id": 8, "title": "Retained node outcomes", "type": "timeseries", "gridPos": {"x": 8, "y": 12, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_nodes{status=~\"failed|interrupted|cancelled\"}", "legendFormat": "{{status}}"}]},
    {"id": 9, "title": "Trace lookup", "type": "text", "gridPos": {"x": 16, "y": 12, "w": 8, "h": 5}, "options": {"mode": "markdown", "content": "Open the local Jaeger UI (default http://localhost:16686), choose flowdesk-agent and search the flowdesk.run_id tag. Use the configured JAEGER_HOST_PORT if changed. Traces include metadata only. Local trace storage is temporary; retained ledger gauges may decrease after cleanup."}},
    {"id": 10, "title": "Go tool HTTP errors / second", "type": "timeseries", "gridPos": {"x": 0, "y": 17, "w": 8, "h": 6}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (code) (rate(http_server_requests_code_total{path=\"/internal/v1/tools/:tool_name\",code=~\"[45]..\"}[5m]))", "legendFormat": "{{code}}"}]},
    {"id": 11, "title": "Retrieval node P95 (last five minutes, ms)", "type": "stat", "gridPos": {"x": 8, "y": 17, "w": 8, "h": 6}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_retrieval_node_p95_milliseconds"}]},
    {"id": 12, "title": "Retained embedding input tokens", "type": "stat", "gridPos": {"x": 16, "y": 17, "w": 8, "h": 6}, "datasource": {"type": "prometheus", "uid": "flowdesk-prometheus"}, "targets": [{"refId": "A", "expr": "flowdesk_agent_embedding_tokens"}]}
  ]
}
