    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "antd": "6.6.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "swagger2openapi": "7.0.8",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "3.2.4"
  }
