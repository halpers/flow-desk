{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowdesk.local/contracts/tools/v1/read.schema.json",
  "title": "Read tool request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_name", "arguments"],
  "properties": {
    "tool_name": {"enum": ["order.lookup", "logistics.track", "ticket.search"]},
    "arguments": {
      "type": "object", "additionalProperties": false, "required": ["order_no"],
      "properties": {"order_no": {"type": "string", "pattern": "^[A-Za-z0-9-]{4,50}$"}}
    }
  }
}
