            "minimum": 0.0,
            "title": "Checkpoint Count",
            "type": "integer"
          },
          "checkpoint_write_count": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Checkpoint Write Count",
            "type": "integer"
          },
          "command_count": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Command Count",
            "type": "integer"
          },
          "embedding_call_count": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Embedding Call Count",
