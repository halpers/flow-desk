{
  "components": {
    "schemas": {
      "CancelCommand": {
        "additionalProperties": false,
        "properties": {
          "dispatch_id": {
            "format": "uuid",
            "title": "Dispatch Id",
            "type": "string"
          },
          "lease_generation": {
            "minimum": 1.0,
            "title": "Lease Generation",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "dispatch_id",
          "run_id",
          "lease_generation"
        ],
        "title": "CancelCommand",
        "type": "object"
      },
      "CommandReceipt": {
        "properties": {
          "dispatch_id": {
            "format": "uuid",
            "title": "Dispatch Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "dispatch_id",
          "status"
        ],
        "title": "CommandReceipt",
        "type": "object"
      },
      "ExecutionCommand": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "enum": [
              "execute",
              "resume"
            ],
            "title": "Command",
            "type": "string"
          },
          "dispatch_id": {
            "format": "uuid",
            "title": "Dispatch Id",
            "type": "string"
          },
          "graph_version": {
            "enum": [
              "read-v1",
              "ticket-v1"
            ],
            "title": "Graph Version",
            "type": "string"
          },
          "lease_generation": {
            "minimum": 1.0,
            "title": "Lease Generation",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "dispatch_id",
          "run_id",
          "lease_generation",
          "command",
          "graph_version"
        ],
        "title": "ExecutionCommand",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "Health",
        "type": "object"
      },
      "IndexCommand": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "version_id"
        ],
        "title": "IndexCommand",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FlowDesk Agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
