            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Queued Command Count",
            "type": "integer"
          },
          "reserved_embedding_call_count": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Reserved Embedding Call Count",
            "type": "integer"
